# Copy this file to backend/.env and fill in the providers you want to use.
# Never commit backend/.env.
#
# Provider priority is defined in backend/config/settings.py. A provider is only
# used when its key is present (see ENABLE_* / PROVIDER_PRIORITY).

# OpenRouter
OPENROUTER_API_KEY=

# Groq
GROQ_API_KEY=



# OpenAI

# Anthropic Claude (final fallback)
# CLAUDE_API_KEY is also accepted for older setups.
ANTHROPIC_API_KEY=

# Optional: shared secret. When set, every state-changing request must send
# it in the X-Jarvis-Token header. Leave empty for local desktop use; the
# Origin/Sec-Fetch-Site guard still applies.
JARVIS_LOCAL_TOKEN=

# ---------------------------------------------------------------------------
# TELEGRAM BRIDGE (optional: talk to JARVIS from your phone)
# ---------------------------------------------------------------------------
# 1. Telegram par @BotFather -> /newbot -> token copy karo.
# 2. Apne bot ko ek message bhejo, phir browser me kholo:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    aur "chat": {"id": 123456789, ...} se id copy karo.
# 3. Wo id TELEGRAM_ALLOWED_CHAT_IDS me daalo (multiple ho to comma se).
# Token khaali chhodo to bridge band rehta hai.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Morning briefing (24-hour local time). Hour 0-23 ke bahar = band.
JARVIS_BRIEFING_HOUR=8
JARVIS_BRIEFING_MINUTE=30

# Windows toast notifications (1 = on, 0 = off)
JARVIS_NOTIFICATIONS=1

# Telegram voice calls need a real user account (bots cannot call).
# 1. https://my.telegram.org -> API development tools -> api_id / api_hash
# 2. Set the two values below, restart the backend.
# 3. POST /telegram-call/login/start {"phone": "+91XXXXXXXXXX"} then
#    POST /telegram-call/login/verify {"code": "12345"} (password if 2FA).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Answer incoming private calls automatically with a spoken greeting.
TELEGRAM_CALL_AUTO_ANSWER=1

# Optional WAV path for the greeting; otherwise one is generated locally.
TELEGRAM_CALL_GREETING=
# Phase B: call me bolo/sunna (listen + answer + system tools).
TELEGRAM_CALL_CONVERSATION=1
# auto = Whisper khud detect kare (Hinglish), ya en, hi, ...
TELEGRAM_CALL_LANGUAGE=auto

# Only these Telegram user ids may call JARVIS (empty = anyone).
TELEGRAM_CALL_ALLOWED=

# OLLAMA (local model, no API key, used when the cloud keys fail)
# Install: https://ollama.com  ->  ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Empty = first installed model (qwen preferred)
OLLAMA_MODEL=
OLLAMA_MAX_TOKENS=250
ENABLE_OLLAMA=1

# REPLY LANGUAGE (hinglish default, or english / hindi)
JARVIS_LANGUAGE=hinglish

# SEMANTIC MEMORY (local embeddings, no API key; model downloads once)
SEMANTIC_MEMORY=1
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_TOP_K=3
SEMANTIC_MIN_SCORE=0.28

# Fast Windows speech for calls; edge sounds natural but waits for the network.
TTS_ENGINE=sapi
TTS_SAPI_VOICE=Microsoft Zira Desktop
TTS_SAPI_RATE=1
TTS_VOICE=en-US-AndrewMultilingualNeural
TELEGRAM_CALL_SILENCE_SECONDS=0.7

# Image generation (OpenRouter images endpoint).
# Put a working key here; the free model needs no credits.
OPENROUTER_API_KEY=
IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free

# Groq (console.groq.com/keys). MiniMax M2 is the default brain here.
GROQ_API_KEY=
GROQ_MODEL=minimaxai/minimax-m2.7
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# Telegram calls: transcribe on Groq's Whisper API (~0.5s) instead of the local
# CPU model, which needs seconds per sentence. Any failure falls back to local.
GROQ_STT=1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT=8

# Z.ai / Zhipu GLM (z.ai -> API Keys). OpenAI-compatible endpoint.
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# SiliconFlow (open models: DeepSeek, Qwen, GLM, Kimi). Base URL can be
# switched to https://api.siliconflow.cn/v1/ for the China region.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Screen watching: explain new pages and pointed-at things in the background.
# SCREEN_WATCH_SPEAK=0 keeps it silent (toast only).
SCREEN_WATCH_INTERVAL=8
SCREEN_WATCH_COOLDOWN=25
SCREEN_WATCH_SPEAK=1

# Bundled Node runtime + REA for the reverse-engineering tool. Point this outside
# the repository so editors, watchers and virus scans never walk its 24,000
# files; without it the tool looks in backend/data/tools.
# JARVIS_TOOLS_DIR=C:\Users\you\AppData\Local\Jarvis\tools

# Email: send with SMTP, read the inbox with IMAP. Use an app password, not
# your normal login password (Gmail: Account -> Security -> App passwords).
# SMTP_SSL=1 means port 465; set it to 0 for STARTTLS on port 587.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=you@gmail.com
# SMTP_SSL=1
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
